# Copy to .env and fill in. .env is never committed.

# ---- Claude: one of the two providers (see dubstudio/ai.py) ----
AI_PROVIDER=openrouter             # openrouter (public internet) or gateway (Pocket FM, VPN only)
OPENROUTER_API_KEY=                # the project's own key
OPENROUTER_CLAUDE_MODEL=anthropic/claude-sonnet-5.5
OPENROUTER_FAST_MODEL=anthropic/claude-haiku-5.5
AI_BASE=https://madeye.internal.pocketfm.org
AI_KEY=
AI_EMAIL=
AI_MODEL=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5
AI_CACHE=true                      # re-use the repeated part of a prompt (rules + shot frames): same prompt, ~half the input bill

# ---- accounts (id + password sign-in) ----
AUTH_REQUIRED=true                 # false = the old single-user mode, no sign-in
AUTH_SESSION_TTL_SECONDS=604800    # a sign-in lasts 7 days
ADMIN_USERNAME=                    # the first (owner) account, made when the database has no accounts
ADMIN_PASSWORD=                    # empty: a password is made up and printed once in the server log

# ---- cloud storage: Cloudflare R2 (S3-compatible) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=                       # https://<account id>.r2.cloudflarestorage.com (built from the account id if empty)
R2_PREFIX=                         # optional folder inside the bucket, e.g. dub-studio-mac
R2_AUTO_UPLOAD=true                # send every finished episode's deliverables up by itself
R2_DB_SYNC=true                    # copy the database file up at startup

# ---- the deployed platform (docs/09): empty here = SQLite + events in this process ----
DATABASE_URL=                      # postgresql://dubstudio:dubstudio@127.0.0.1:5433/dubstudio (app/docker-compose.yml)
REDIS_URL=                         # redis://127.0.0.1:6380/0 -- only needed with more than one worker or API replica
MAX_ACTIVE_EPISODES=1              # how many episodes are worked on at once (1 = one by one)
UPLOAD_MODE=proxy                  # proxy: the API passes the file through; direct: the browser PUTs to R2 (needs CORS)
CLEAN_WORK=false                   # true: also delete proxies and rendered pieces when an episode is delivered
DUBSTUDIO_SCENE_SECONDS=           # test only: cut the scene edit to the first N seconds (empty = the whole episode)

# ---- rented workers (RunPod serverless) ----
RUNPOD_API_KEY=
RUNPOD_CPU_ENDPOINT=               # CPU endpoint id (dashboard: Serverless → New Endpoint → CPU)
RUNPOD_GPU_ENDPOINT=               # GPU endpoint for face map (CUDA image, baked venv_face)
CLOUD_STEPS=lip_gpu                # lip_gpu, or "all"/"tail" to also run the render tail on one machine
CLOUD_PIECES=8                     # how many machines a lip scan is split across
CLOUD_AI=false                     # true = send OpenRouter key to workers for facemap/qc/library
